# Local development: copy to .env. On a cloud host, set these as environment variables instead.

# 1 for local development only. Must be 0 (or unset) on the internet.
DJANGO_DEBUG=1

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Key used to pseudonymize names/employee IDs during import. Keep it stable and backed up:
# if it changes, previously imported people are no longer recognized.
PII_HMAC_KEY=

# --- Production -----------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=budget.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://budget.example.com
# DATABASE_URL=postgres://user:password@host:5432/facultyfunds
# Number of trusted reverse proxies in front of the app (1 on Render/Fly/Railway); used for login lockouts.
# AXES_PROXY_COUNT=1

# --- Optional -------------------------------------------------------------------
# DJANGO_ADMIN_URL=admin/
# SESSION_IDLE_SECONDS=7200
# TIME_ZONE=America/New_York
