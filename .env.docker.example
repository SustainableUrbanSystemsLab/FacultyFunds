# Docker Compose deployment: copy to .env (git-ignored) and fill in. Never commit .env.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# (URL-safe characters only, so they are safe inside DATABASE_URL.)

POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
# Keep stable and back it up: if it changes, imported people are no longer recognized.
PII_HMAC_KEY=

# Hostname you will use in the browser (reverse proxy name), no scheme.
DJANGO_ALLOWED_HOSTS=funds.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://funds.example.com

# Optional
# HOST_PORT=8020
# BIND=127.0.0.1
# TIME_ZONE=America/New_York
